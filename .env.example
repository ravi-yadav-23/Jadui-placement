# ==========================================
# JADUI PLACEMENT: backend environment (copy to backend/.env)
# ==========================================

# 1. Supabase (database, storage, auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-on-frontend
# Only if your project signs JWTs with the legacy shared secret (HS256).
# Projects using asymmetric signing keys are verified via the public JWKS URL automatically.
SUPABASE_JWT_SECRET=

# 2. LLM providers (resume v2 uses Gemini first, Groq as fallback)
GEMINI_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Check current model IDs: https://ai.google.dev/gemini-api/docs/deprecations
# (gemini-2.0-flash and gemini-1.5-flash are shut down)
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45

# 3. Resume v2 limits
RESUME_MAX_BYTES=5242880
RESUME_MAX_PAGES=3
DAILY_UPLOAD_LIMIT=10
DAILY_ANALYSIS_LIMIT=15

# 4. Local development / E2E only
# DATABASE_BACKEND=memory   -> keep data in RAM instead of Supabase
# LLM_PROVIDER=fake         -> deterministic canned AI answers, no API calls

# 5. Interviews, planner, coach
DAILY_INTERVIEW_LIMIT=5
COACH_DAILY_MESSAGES=60
PLANNER_BUFFER=0.15

# 6. App
PORT=8000
DEBUG=False
ALLOWED_ORIGINS=["http://localhost:3000","https://jadui-placement.vercel.app"]
