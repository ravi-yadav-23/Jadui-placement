# Frontend environment: copy to frontend/.env.local

# Supabase (login session; the backend verifies the token)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Site URL (robots.txt, sitemap)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Legacy mentor chat route (server-side only; moves to the backend in the coach rebuild)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# E2E only, never in a real deployment: a test JWT the frontend sends instead of a Supabase session
# NEXT_PUBLIC_E2E_ACCESS_TOKEN=
